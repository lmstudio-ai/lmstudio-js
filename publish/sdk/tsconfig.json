{
  "include": ["src/index.ts"],
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2021",
    "rootDir": "src",
    "declaration": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "outDir": "ts-out",
    "esModuleInterop": true
  }
}
